# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ===== Auth =====
JWT_SECRET="AkhyaSinha"
JWT_EXPIRES_IN=7d

# ===== Database =====
# SQLite file path (zero external DB setup required for local/dev & grading)
DB_STORAGE_PATH=./data/healthcare.sqlite

# ===== LLM (used for pre-visit & post-visit summaries) =====
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2

# ===== Email (Nodemailer - works with SendGrid/Mailgun/SMTP/Gmail) =====
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_password
EMAIL_FROM="Healthcare Clinic <no-reply@clinic.example.com>"
# If true, emails are only logged to console/DB instead of actually sent (useful for local dev/grading)
EMAIL_DRY_RUN=true

# ===== Google Calendar (OAuth 2.0) =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
# If true, calendar calls are mocked/logged instead of hitting the real Google API (useful for local dev/grading)
CALENDAR_DRY_RUN=true

# ===== Background Jobs =====
# Cron expression for medication reminder + email retry sweep (default: every 10 min)
REMINDER_CRON=*/10 * * * *
NOTIFICATION_RETRY_MAX_ATTEMPTS=5

# ===== Slot Hold =====
SLOT_HOLD_TTL_SECONDS=300
